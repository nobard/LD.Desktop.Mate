<Window x:Class="Mate.MVVM.Views.NotificationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Mate.Models"
        Width="360"
        Height="76"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="NotificationSurface" TargetType="Border">
            <Setter Property="Cursor" Value="Arrow" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAction}" Value="True">
                    <Setter Property="Cursor" Value="Hand" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PopupCloseButton" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Width="20"
                                Height="20"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonHover}" />
                                <Setter Property="Foreground" Value="#D8D8D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Fill">
        <Grid Width="360" Height="76">
            <Border x:Name="PopupSurface"
                    Style="{StaticResource NotificationSurface}"
                    Margin="5"
                    Padding="13,10"
                    Background="{DynamicResource Theme.WindowBackground}"
                    BorderBrush="{DynamicResource Theme.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="13"
                    RenderTransformOrigin="0.5,0"
                    MouseLeftButtonUp="PopupSurface_MouseLeftButtonUp">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="18"
                                      ShadowDepth="4"
                                      Opacity="0.55" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PopupScaleTransform" />
                        <TranslateTransform x:Name="PopupTranslateTransform" />
                    </TransformGroup>
                </Border.RenderTransform>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32"
                            Height="32"
                            Background="{DynamicResource Theme.ButtonBackground}"
                            CornerRadius="9"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 5,16 L 19,16 M 7,16 L 7,10 C 7,6.7 9,5 12,5 C 15,5 17,6.7 17,10 L 17,16 M 10,19 C 10.5,20.2 11.1,21 12,21 C 12.9,21 13.5,20.2 14,19 M 12,3 L 12,5"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="#B1B1B1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MateNotificationKind.Update}">
                                                    <Setter Property="Stroke" Value="#66A9FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MateNotificationKind.Success}">
                                                    <Setter Property="Stroke" Value="#79C58A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MateNotificationKind.Warning}">
                                                    <Setter Property="Stroke" Value="#D3AE67" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MateNotificationKind.Error}">
                                                    <Setter Property="Stroke" Value="#D67A7A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <Grid Grid.Column="1" Margin="8,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}"
                                   Foreground="#F0F0F0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Message}"
                                   Foreground="#9A9A9A"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Column="2" MinWidth="72">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>

                        <Button Style="{StaticResource PopupCloseButton}"
                                ToolTip="Закрыть"
                                Click="DismissButton_Click"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                            <Viewbox Width="9" Height="9">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M 4,4 L 12,12 M 12,4 L 4,12"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Source}"
                                       Foreground="#6F6F6F"
                                       FontSize="10" />
                            <TextBlock Text=" · "
                                       Foreground="#555555"
                                       FontSize="10" />
                            <TextBlock Text="{Binding TimeText}"
                                       Foreground="#6F6F6F"
                                       FontSize="10" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</Window>
