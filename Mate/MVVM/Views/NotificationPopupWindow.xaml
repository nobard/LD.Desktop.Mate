<Window x:Class="Mate.MVVM.Views.NotificationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Mate.Models"
        Width="360"
        Height="76"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Viewbox Stretch="Fill">
        <Grid Width="360" Height="76">
            <Border x:Name="PopupSurface"
                    Margin="5"
                    Padding="13,10"
                    Background="{DynamicResource Theme.WindowBackground}"
                    BorderBrush="{DynamicResource Theme.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="13"
                    RenderTransformOrigin="0.5,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="18"
                                      ShadowDepth="4"
                                      Opacity="0.55" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PopupScaleTransform" />
                        <TranslateTransform x:Name="PopupTranslateTransform" />
                    </TransformGroup>
                </Border.RenderTransform>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32"
                            Height="32"
                            Background="{DynamicResource Theme.ButtonBackground}"
                            CornerRadius="9"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18">
                            <Path Data="M 5,15 L 19,15 M 7,15 L 7,10 C 7,6.7 9,5 12,5 C 15,5 17,6.7 17,10 L 17,15 M 10,18 C 10.5,19.2 11.1,20 12,20 C 12.9,20 13.5,19.2 14,18 M 12,3 L 12,5"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="#B1B1B1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MateNotificationKind.Update}">
                                                <Setter Property="Stroke" Value="#66A9FF" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MateNotificationKind.Success}">
                                                <Setter Property="Stroke" Value="#79C58A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MateNotificationKind.Warning}">
                                                <Setter Property="Stroke" Value="#D3AE67" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MateNotificationKind.Error}">
                                                <Setter Property="Stroke" Value="#D67A7A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Viewbox>
                    </Border>

                    <Grid Grid.Column="1" Margin="8,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}"
                                   Foreground="#F0F0F0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Message}"
                                   Foreground="#9A9A9A"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Source}"
                               Foreground="#6F6F6F"
                               FontSize="10"
                               Margin="0,2,0,0"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</Window>
