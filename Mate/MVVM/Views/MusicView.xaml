<UserControl x:Class="Mate.MVVM.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="PlaybackButton" TargetType="Button">
            <Setter Property="Width" Value="45" /><Setter Property="Height" Value="45" /><Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="22"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#292929" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#353535" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.28" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MediaProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" /><Setter Property="Background" Value="#404040" /><Setter Property="Foreground" Value="#E7E7E7" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="42,30,38,30">
        <Grid.RowDefinitions><RowDefinition Height="17" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="0,34,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>

            <Border Width="104" Height="104" Background="#292929" CornerRadius="12" VerticalAlignment="Top">
                <Grid ClipToBounds="True">
                    <Grid.Clip><RectangleGeometry Rect="0,0,104,104" RadiusX="12" RadiusY="12" /></Grid.Clip>
                    <Grid><Path Data="M 0,79 C 17,61 35,59 53,68 C 72,78 79,90 104,72 L 104,104 L 0,104 Z" Fill="#3A3A3A" /><Ellipse Width="45" Height="45" Fill="#414141" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,17,0" /></Grid>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="32,15,20,0" VerticalAlignment="Top">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="42" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding TrackTitle}" Foreground="#F3F3F3" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Text="{Binding Artist}" Foreground="#929292" FontSize="14" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ElapsedTime}" Foreground="#8A8A8A" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <ProgressBar Grid.Column="1" Style="{StaticResource MediaProgress}" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage, Mode=OneWay}" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Style="{StaticResource PlaybackButton}" ToolTip="Предыдущий трек" Command="{Binding SkipPreviousCommand}"><Viewbox Width="24" Height="24"><Path Data="M 7,5 L 7,19 M 18,5 L 8,12 L 18,19 Z" Stroke="#E6E6E6" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" /></Viewbox></Button>
                <Button Style="{StaticResource PlaybackButton}" ToolTip="{Binding PlayPauseToolTip}" Command="{Binding TogglePlayPauseCommand}" Margin="7,0"><TextBlock Text="{Binding PlayPauseGlyph}" Foreground="#F5F5F5" FontSize="25" FontFamily="Segoe UI Symbol" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
                <Button Style="{StaticResource PlaybackButton}" ToolTip="Следующий трек" Command="{Binding SkipNextCommand}"><Viewbox Width="24" Height="24"><Path Data="M 17,5 L 17,19 M 6,5 L 16,12 L 6,19 Z" Stroke="#E6E6E6" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent" /></Viewbox></Button>
            </StackPanel>

            <TextBlock Grid.Column="3" Text="{Binding Source}" Foreground="#898989" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>
