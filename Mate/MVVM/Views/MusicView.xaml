<UserControl x:Class="Mate.MVVM.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="42,30,38,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Foreground="#A1A1A1" FontSize="17" />
        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Background="#2A2A2A" CornerRadius="12">
                <Path Data="M 43,28 L 43,70 M 43,37 L 69,31 M 69,31 L 69,62 M 37,70 A 8,8 0 1 0 53,70 A 8,8 0 1 0 37,70 M 63,62 A 8,8 0 1 0 79,62 A 8,8 0 1 0 63,62" Stroke="#B8B8B8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Border>
            <StackPanel Grid.Column="1" Margin="24,6,35,0" VerticalAlignment="Top">
                <TextBlock Text="Нет активного трека" Foreground="#F0F0F0" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="Ожидание воспроизведения" Foreground="#8C8C8C" FontSize="14" Margin="0,6,0,27" />
                <Grid><ProgressBar Height="3" Value="0" Maximum="100" Background="#383838" Foreground="#E6E6E6" BorderThickness="0" /><TextBlock Text="0:00" Foreground="#8C8C8C" FontSize="12" Margin="0,10,0,0" /></Grid>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="◀" Foreground="#E8E8E8" Background="Transparent" BorderThickness="0" FontSize="18" Padding="11" />
                <Button Content="▶" Foreground="#FFFFFF" Background="#303030" BorderThickness="0" FontSize="19" Padding="13,10" Margin="5,0" />
                <Button Content="▶" RenderTransformOrigin="0.5,0.5" Foreground="#E8E8E8" Background="Transparent" BorderThickness="0" FontSize="18" Padding="11"><Button.RenderTransform><ScaleTransform ScaleX="-1" /></Button.RenderTransform></Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
