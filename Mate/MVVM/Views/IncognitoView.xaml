<UserControl x:Class="Mate.MVVM.Views.IncognitoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource MateTextBoxBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="CaretBrush" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="OpenButton" TargetType="Button">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="#D5D5D5" />
            <Setter Property="Background" Value="{DynamicResource Theme.ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonHover}" /><Setter Property="Foreground" Value="#F2F2F2" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonPressed}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchClearButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.SurfacePressed}" /><Setter Property="Foreground" Value="#D8D8D8" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.SelectedBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSearchQuery}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="31,20,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Theme.SearchBackground}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="8">
                <Grid Margin="11,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="21" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                        <Path Data="M 7,2 A 5,5 0 1 0 7,12 A 5,5 0 1 0 7,2 M 11,11 L 16,16" Stroke="#858585" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                    </Viewbox>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource SearchBox}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Margin="4,0,0,0"
                             ToolTip="Введите запрос или ссылку">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2"
                            Style="{StaticResource SearchClearButton}"
                            Content="×"
                            Command="{Binding ClearSearchCommand}"
                            ToolTip="Очистить поиск" />
                </Grid>
            </Border>

            <Button Grid.Column="1"
                    Style="{StaticResource OpenButton}"
                    Content="Открыть"
                    Command="{Binding SearchCommand}"
                    Margin="10,0,0,0" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="31,18,24,0">
            <TextBlock Text="Введите запрос или ссылку" Foreground="#A0A0A0" FontSize="13" />
            <TextBlock Text="{Binding ModeDescription}" Foreground="#6F6F6F" FontSize="11" Margin="0,6,0,0" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B79C9C" FontSize="10" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
