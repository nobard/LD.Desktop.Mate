<Window x:Class="Mate.MVVM.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="310"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="TrayMenuButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="#DEDEDE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonHover}" />
                                <Setter Property="Foreground" Value="#F2F2F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayToggleButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="#DEDEDE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <Grid Margin="{TemplateBinding Padding}">
                                <ContentPresenter Margin="0,0,48,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                                <Grid Width="34"
                                      Height="18"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center">
                                    <Border x:Name="Track"
                                            Background="{DynamicResource Theme.ProgressTrack}"
                                            BorderBrush="{DynamicResource Theme.BorderStrong}"
                                            BorderThickness="1"
                                            CornerRadius="9" />
                                    <Ellipse x:Name="Thumb"
                                             Width="12"
                                             Height="12"
                                             Margin="3,0"
                                             HorizontalAlignment="Left"
                                             Fill="#858585" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonHover}" />
                                <Setter Property="Foreground" Value="#F2F2F2" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#A5A5A5" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#666666" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#777777" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#F0F0F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Padding="6"
            Background="{DynamicResource Theme.WindowBackground}"
            BorderBrush="{DynamicResource Theme.BorderStrong}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.65" />
        </Border.Effect>

        <StackPanel>
            <Button Style="{StaticResource TrayMenuButton}"
                    Content="Открыть Mate"
                    Command="{Binding OpenMateCommand}" />
            <Button Style="{StaticResource TrayMenuButton}"
                    Content="Настройки"
                    Command="{Binding OpenSettingsCommand}" />

            <Border Height="1"
                    Margin="10,5"
                    Background="{DynamicResource Theme.Border}" />

            <ToggleButton Style="{StaticResource TrayToggleButton}"
                          Content="Отключить открытие по наведению"
                          IsChecked="{Binding IsHoverActivationDisabled, Mode=OneWay}"
                          Command="{Binding ToggleHoverActivationCommand}" />

            <Border Height="1"
                    Margin="10,5"
                    Background="{DynamicResource Theme.Border}" />

            <Button Style="{StaticResource TrayMenuButton}"
                    Content="Выход"
                    Foreground="#C99191"
                    Command="{Binding ExitCommand}" />
        </StackPanel>
    </Border>
</Window>
