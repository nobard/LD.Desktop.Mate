<Window x:Class="Mate.MVVM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:Mate.MVVM.ViewModels"
        Icon="/Assets/MateTray.ico"
        Width="840" Height="340" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#929292" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavigationBackground" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavigationBackground" Property="Background" Value="{DynamicResource Theme.NavigationHover}" /><Setter Property="Foreground" Value="#F0F0F0" /></Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="NavigationBackground" Property="Background" Value="{DynamicResource Theme.SelectedBackground}" /><Setter Property="Foreground" Value="#FFFFFF" /></DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationScrollButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ArrowSurface"
                                Width="18"
                                Height="18"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource Theme.NavigationHover}" />
                                <Setter Property="Foreground" Value="#D0D0D0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderSourceItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#B8B8B8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                                <Setter Property="Foreground" Value="#EEEEEE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#E8E8E8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderSourceComboBox" TargetType="ComboBox">
            <Setter Property="Width" Value="172" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="#898989" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource HeaderSourceItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="SourceSurface"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="0">
                                            <Grid>
                                                <ContentPresenter VerticalAlignment="Bottom"
                                                                  HorizontalAlignment="Right"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  RecognizesAccessKey="True" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#BEBEBE" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        MaxHeight="190"
                                        Margin="0,4,0,0"
                                        Padding="2"
                                        Background="{DynamicResource Theme.SurfaceLow}"
                                        BorderBrush="{DynamicResource Theme.Border}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateIndicatorButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#43B581" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="UpdateSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M 7,1 L 7,8 M 3.5,5 L 7,8.5 L 10.5,5 M 2,11 L 2,12.5 L 12,12.5 L 12,11"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UpdateSurface" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                                <Setter Property="Foreground" Value="#57D79A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.68" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Fill">
    <Grid x:Name="WindowSurface"
          Width="840"
          Height="340"
          RenderTransformOrigin="0.5,0"
          RenderOptions.BitmapScalingMode="LowQuality">
        <Grid.CacheMode>
            <BitmapCache RenderAtScale="1" />
        </Grid.CacheMode>
        <Grid.RenderTransform>
            <ScaleTransform x:Name="OpenScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Path Fill="{DynamicResource Theme.WindowBackground}"
              Data="M 0,0 L 4,0 C 13,0 20,7 20,16 L 20,325 C 20,333 27,340 35,340 L 805,340 C 813,340 820,333 820,325 L 820,16 C 820,7 827,0 836,0 L 840,0 Z" />

        <Grid Margin="20,0,20,0">
            <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="24"
                        Margin="22,0,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                <TextBlock Text="{Binding CurrentToolTitle}"
                           Margin="0,0,7,0"
                           Foreground="#9A9A9A"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource UpdateIndicatorButton}"
                        Command="{Binding OpenUpdateCommand}"
                        ToolTip="{Binding UpdateText}" />
            </StackPanel>
            <ContentControl Grid.Row="0"
                            Grid.ColumnSpan="3"
                            Content="{Binding NavigationService.CurrentView.HeaderContent}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,22,10">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type viewModels:MusicViewModel}">
                        <ComboBox Style="{StaticResource HeaderSourceComboBox}"
                                  ItemsSource="{Binding Sources}"
                                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  ToolTip="Выбрать источник воспроизведения">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
            <Grid Grid.Row="1"
                  Grid.Column="0"
                  Width="48"
                  Height="280"
                  Margin="0,5"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="18" />
                    <RowDefinition Height="244" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>

                <Button x:Name="NavigationUpButton"
                        Grid.Row="0"
                        Style="{StaticResource NavigationScrollButton}"
                        ToolTip="Прокрутить вверх"
                        Click="NavigationScrollUp_Click">
                    <Viewbox Width="10" Height="6">
                        <Grid Width="10" Height="6">
                            <Path Data="M 1,5 L 5,1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Path Data="M 9,5 L 5,1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>
                    </Viewbox>
                </Button>

                <Border x:Name="NavigationViewport"
                        Grid.Row="1"
                        ClipToBounds="True">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Black" Offset="0" />
                            <GradientStop Color="Black" Offset="0.055" />
                            <GradientStop Color="Black" Offset="0.945" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                    <ScrollViewer x:Name="NavigationScrollViewer"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  Focusable="False"
                                  PanningMode="VerticalOnly"
                                  ScrollChanged="NavigationScrollViewer_ScrollChanged"
                                  PreviewMouseWheel="NavigationScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding NavigationItems}"
                                      HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:NavigationItemViewModel}">
                            <Button Style="{StaticResource NavigationButton}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    AllowDrop="True"
                                    DragEnter="NavigationButton_DragEnter"
                                    DragOver="NavigationButton_DragOver"
                                    DragLeave="NavigationButton_DragLeave"
                                    Drop="NavigationButton_Drop">
                                <Grid Width="24" Height="24">
                                    <Canvas x:Name="MusicIcon" Width="24" Height="24" Visibility="Collapsed"><Path Data="M 8,3 L 8,16 C 6,15 3,16 3,19 C 3,23 10,23 10,19 L 10,7 L 18,5 L 18,15 C 16,14 13,15 13,18 C 13,22 20,22 20,18 L 20,3 L 8,6 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Canvas>
                                    <Canvas x:Name="FolderIcon" Width="24" Height="24" Visibility="Collapsed"><Path Data="M 3,7 L 10,7 L 12,5 L 21,5 L 21,19 L 3,19 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent" /></Canvas>
                                    <Canvas x:Name="ClipboardIcon" Width="24" Height="24" Visibility="Collapsed"><Path Data="M 6,5 L 18,5 L 18,20 L 6,20 Z M 9,5 L 9,3 L 15,3 L 15,5 M 9,10 L 15,10 M 9,14 L 15,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent" /></Canvas>
                                    <Canvas x:Name="PinIcon" Width="24" Height="24" Visibility="Collapsed"><Path Data="M 8,3 L 16,3 L 16,8 L 19,11 L 19,13 L 13,13 L 13,21 L 11,21 L 11,13 L 5,13 L 5,11 L 8,8 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Canvas>
                                    <Canvas x:Name="BrowserIcon" Width="24" Height="24" Visibility="Collapsed">
                                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 StrokeThickness="1.7" />
                                        <Path Data="M 3.8,12 L 20.2,12 M 12,3.5 C 8.8,6.7 8.8,17.3 12,20.5 M 12,3.5 C 15.2,6.7 15.2,17.3 12,20.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent" />
                                    </Canvas>
                                    <Canvas x:Name="IncognitoIcon" Width="24" Height="24" Visibility="Collapsed">
                                        <Path Data="M 8.5,3.5 L 15.5,3.5 L 17,9 L 7,9 Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <Path Data="M 3,10 C 7,11 17,11 21,10"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent" />
                                        <Ellipse Canvas.Left="3.5" Canvas.Top="13" Width="7" Height="7"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 StrokeThickness="1.7" />
                                        <Ellipse Canvas.Left="13.5" Canvas.Top="13" Width="7" Height="7"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 StrokeThickness="1.7" />
                                        <Path Data="M 10.5,16.5 C 11.3,15.7 12.7,15.7 13.5,16.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent" />
                                    </Canvas>
                                    <Canvas x:Name="NotificationsIcon" Width="24" Height="24" Visibility="Collapsed">
                                        <Path Data="M 5,17 L 7,15 L 7,10 C 7,6.8 9,5 12,5 C 15,5 17,6.8 17,10 L 17,15 L 19,17 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent" />
                                        <Path Data="M 10,20 C 10.7,21.2 13.3,21.2 14,20"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent" />
                                    </Canvas>
                                    <Canvas x:Name="PomodoroIcon" Width="24" Height="24" Visibility="Collapsed">
                                        <Path Data="M 12,8.3 C 9.8,7.2 7.1,7.5 5.3,9 C 3.5,10.5 3.1,13.2 3.9,16 C 5,19.5 8,21.2 12,21.2 C 16,21.2 19,19.5 20.1,16 C 20.9,13.2 20.5,10.5 18.7,9 C 16.9,7.5 14.2,7.2 12,8.3 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent" />
                                        <Path Data="M 12,8.7 L 8,5.2 L 9.3,8 L 5.9,7.7 L 9.5,10.1 L 12,8.7 L 14.5,10.1 L 18.1,7.7 L 14.7,8 L 16,5.2 Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeLineJoin="Round"
                                              SnapsToDevicePixels="True" />
                                        <Path Data="M 12,7.2 L 12,3.2"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                    <Canvas x:Name="TranslateIcon" Width="24" Height="24" Visibility="Collapsed"><TextBlock Canvas.Left="1" Canvas.Top="0" Text="A" FontSize="18" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Canvas.Left="11" Canvas.Top="7" Text="文" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Canvas>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ToolTip}" Value="Плеер"><Setter TargetName="MusicIcon" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding ToolTip}" Value="Папка"><Setter TargetName="FolderIcon" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding ToolTip}" Value="Буфер обмена"><Setter TargetName="ClipboardIcon" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding ToolTip}" Value="Заготовки"><Setter TargetName="PinIcon" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding ToolTip}" Value="Браузер"><Setter TargetName="BrowserIcon" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding UsePrivateBrowserIcon}" Value="True"><Setter TargetName="BrowserIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="IncognitoIcon" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding ToolTip}" Value="Переводчик"><Setter TargetName="TranslateIcon" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding ToolTip}" Value="Уведомления"><Setter TargetName="NotificationsIcon" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding ToolTip}" Value="Помодоро"><Setter TargetName="PomodoroIcon" Property="Visibility" Value="Visible" /></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Button x:Name="NavigationDownButton"
                        Grid.Row="2"
                        Style="{StaticResource NavigationScrollButton}"
                        ToolTip="Прокрутить вниз"
                        Click="NavigationScrollDown_Click">
                    <Viewbox Width="10" Height="6">
                        <Grid Width="10" Height="6">
                            <Path Data="M 1,1 L 5,5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Path Data="M 9,1 L 5,5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>
                    </Viewbox>
                </Button>
            </Grid>
            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Theme.Divider}" Margin="0,14" />
            <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding NavigationService.CurrentView}" />
        </Grid>
    </Grid>
    </Viewbox>
</Window>
