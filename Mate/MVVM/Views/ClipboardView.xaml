<UserControl x:Class="Mate.MVVM.Views.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="42,30,38,30">
        <TextBlock Text="{Binding Title}" Foreground="#A1A1A1" FontSize="17" />
        <TextBlock Text="{Binding Description}" Foreground="#8C8C8C" FontSize="14" Margin="0,12,0,0" />
        <Border Height="145" Background="#1D1D1D" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="11" Margin="0,20,0,0"><TextBlock Text="Здесь появится содержимое буфера" Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </StackPanel>
</UserControl>
