<UserControl x:Class="Mate.MVVM.Views.FolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Mate.MVVM.ViewModels"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AllowDrop="True"
             PreviewDragOver="FilesDragOver"
             PreviewDragLeave="FilesDragLeave"
             Drop="FilesDrop">
    <UserControl.Resources>
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface" Width="8" Background="#969696" CornerRadius="4" HorizontalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#B0B0B0" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#C4C4C4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="{x:Static ScrollBar.PageUpCommand}" /></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="{x:Static ScrollBar.PageDownCommand}" /></Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FileCardButton" TargetType="Button">
            <Setter Property="Width" Value="126" />
            <Setter Property="Height" Value="154" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceLow}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                                <Setter TargetName="CardSurface" Property="BorderBrush" Value="#656565" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="CardSurface" Property="BorderBrush" Value="#B0B0B0" />
                                <Setter TargetName="CardSurface" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectAllCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#858585" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="13"
                                    Height="13"
                                    Background="Transparent"
                                    BorderBrush="#606060"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <Viewbox Width="8" Height="8">
                                    <Path x:Name="CheckMark"
                                          Data="M 1,4 L 3.5,6.5 L 8,1.5"
                                          Stroke="#171717"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                </Viewbox>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="5,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#8A8A8A" />
                                <Setter Property="Foreground" Value="#B0B0B0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#D8D8D8" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#D8D8D8" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileDeleteButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#A0A0A0" />
            <Setter Property="Background" Value="#B0141414" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Width="22"
                                Height="22"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E02B2B2B" />
                                <Setter Property="Foreground" Value="#F0F0F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F03A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="#D5D5D5" />
            <Setter Property="Background" Value="{DynamicResource Theme.ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FooterSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterSurface" Property="Background" Value="{DynamicResource Theme.ButtonHover}" />
                                <Setter Property="Foreground" Value="#F0F0F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FooterSurface" Property="Background" Value="{DynamicResource Theme.ButtonPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="31,20,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,5,0,0">
                    <CheckBox Content="Выбрать все"
                              Style="{StaticResource SelectAllCheckBox}"
                              IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                              IsEnabled="{Binding HasFiles}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="  ·  "
                               Foreground="#4C4C4C"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectionSummary}"
                               Foreground="#858585"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  ·  "
                               Foreground="#4C4C4C"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#707070"
                               FontSize="10"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource FooterButton}"
                            Content="Удалить"
                            Command="{Binding DeleteSelectedCommand}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="31,11,0,19"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:FileCardViewModel}">
                            <Grid Width="126"
                                  Height="154"
                                  Margin="0,0,8,16">
                                <Button Style="{StaticResource FileCardButton}"
                                        ToolTip="{Binding FilePath}"
                                        Command="{Binding DataContext.ToggleSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        PreviewMouseLeftButtonDown="FileCardMouseLeftButtonDown"
                                        PreviewMouseMove="FileCardMouseMove"
                                        PreviewMouseDoubleClick="FileCardMouseDoubleClick">
                                    <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="82" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{DynamicResource Theme.PlaceholderBackground}" CornerRadius="7" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Border Width="46" Height="54" CornerRadius="5" Background="{DynamicResource Theme.Divider}" BorderBrush="#555555" BorderThickness="1">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Path Data="M 10,3 L 24,3 L 34,13 L 34,43 L 10,43 Z M 24,3 L 24,13 L 34,13"
                                                              Width="25" Height="33" Stretch="Fill" Stroke="#8B8B8B" StrokeThickness="1.4" Fill="Transparent" />
                                                        <TextBlock Text="{Binding Extension}" Foreground="#A8A8A8" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="2,9,2,0">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#E2E2E2"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   MaxWidth="104"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CapturedAt}"
                                                   Foreground="#858585"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Border Width="18" Height="18" CornerRadius="9"
                                            Background="#E3E3E3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="-4,-4,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="✓" Foreground="#1A1A1A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource FileDeleteButton}"
                                        Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Удалить файл"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,6,6,0"
                                        Panel.ZIndex="2">
                                    <Viewbox Width="9" Height="9">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M 4,4 L 12,12 M 12,4 L 4,12"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="1"
                    Margin="31,11,24,19"
                    BorderBrush="{DynamicResource Theme.Divider}"
                    BorderThickness="1"
                    CornerRadius="11"
                    IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M 3,8 L 10,8 L 12,5 L 26,5 L 26,22 L 3,22 Z"
                          Width="31" Height="24" Stretch="Fill" Stroke="#777777" StrokeThickness="1.4" Fill="Transparent" />
                    <TextBlock Text="Перетащите файлы сюда" Foreground="#A0A0A0" FontSize="13" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="Новые скриншоты появятся автоматически" Foreground="#666666" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

        <Border x:Name="DropSurface"
                Grid.RowSpan="2"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False"
                Panel.ZIndex="20" />
    </Grid>
</UserControl>
