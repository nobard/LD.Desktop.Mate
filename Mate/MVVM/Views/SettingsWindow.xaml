<Window x:Class="Mate.MVVM.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Mate.Services.Interfaces"
        Width="430"
        Height="680"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="#858585" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonHover}" />
                                <Setter Property="Foreground" Value="#E5E5E5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeOption" TargetType="RadioButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                                <Setter Property="Foreground" Value="#D8D8D8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonPressed}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#666666" />
                                <Setter Property="Foreground" Value="#F0F0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="38" Height="22">
                            <Border x:Name="Track"
                                    Background="{DynamicResource Theme.ProgressTrack}"
                                    BorderBrush="{DynamicResource Theme.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="11" />
                            <Ellipse x:Name="Thumb"
                                     Width="14"
                                     Height="14"
                                     Margin="4,0"
                                     HorizontalAlignment="Left"
                                     Fill="#A0A0A0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#666666" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#D5D5D5" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#666666" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#777777" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#F0F0F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceLow}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="SettingsComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#B8B8B8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                                <Setter Property="Foreground" Value="#EEEEEE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#F0F0F0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Width" Value="184" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#D8D8D8" />
            <Setter Property="Background" Value="{DynamicResource Theme.ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Surface"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid Margin="10,0,9,0">
                                                <ContentPresenter Margin="0,0,22,0"
                                                                  VerticalAlignment="Center"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                                <Path Data="M 1,2 L 5,6 L 9,2"
                                                      Stroke="{TemplateBinding Foreground}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        MaxHeight="220"
                                        Margin="0,4,0,0"
                                        Padding="3"
                                        Background="{DynamicResource Theme.SurfaceLow}"
                                        BorderBrush="{DynamicResource Theme.BorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="#D8D8D8" />
            <Setter Property="Background" Value="{DynamicResource Theme.ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonHover}" />
                                <Setter Property="Foreground" Value="#F2F2F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.ButtonPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface"
                                Width="5"
                                Background="#777777"
                                CornerRadius="2.5"
                                HorizontalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#999999" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#B5B5B5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track"
                               Orientation="Vertical"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SettingsScrollPageButton}"
                                              Command="{x:Static ScrollBar.PageUpCommand}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SettingsScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SettingsScrollPageButton}"
                                              Command="{x:Static ScrollBar.PageDownCommand}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Background="{DynamicResource Theme.WindowBackground}"
            BorderBrush="{DynamicResource Theme.BorderStrong}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.6" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Настройки"
                           Margin="19,0,0,0"
                           Foreground="#E8E8E8"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource CloseButton}"
                        Command="{Binding CloseCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,0,12,0"
                        ToolTip="Закрыть">
                    <Viewbox Width="10" Height="10">
                        <Canvas Width="16" Height="16">
                            <Path Data="M 4,4 L 12,12 M 12,4 L 4,12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,2,11,12">
                <TextBlock Text="ВНЕШНИЙ ВИД"
                           Foreground="#737373"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Margin="2,0,0,7" />

                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <TextBlock Text="Тема"
                                   Foreground="#D7D7D7"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource ThemeOption}"
                                         Content="Тёмная"
                                         GroupName="Theme"
                                         IsChecked="{Binding IsDarkThemeSelected, Mode=OneWay}"
                                         Command="{Binding SelectThemeCommand}"
                                         CommandParameter="{x:Static services:AppTheme.Dark}" />
                            <RadioButton Style="{StaticResource ThemeOption}"
                                         Content="Чёрная"
                                         GroupName="Theme"
                                         Margin="7,0,0,0"
                                         IsChecked="{Binding IsBlackThemeSelected, Mode=OneWay}"
                                         Command="{Binding SelectThemeCommand}"
                                         CommandParameter="{x:Static services:AppTheme.AlmostBlack}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="ПОВЕДЕНИЕ"
                           Foreground="#737373"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Margin="2,16,0,7" />

                <Border Style="{StaticResource SettingRow}" Margin="0,0,0,7">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Автозапуск"
                                       Foreground="#D7D7D7"
                                       FontSize="12" />
                            <TextBlock Text="Запускать Mate вместе с Windows"
                                       Foreground="#767676"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding IsAutoStartEnabled, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Отключить открытие по наведению"
                                       Foreground="#D7D7D7"
                                       FontSize="12" />
                            <TextBlock Text="Не открывать Mate у верхнего края экрана"
                                       Foreground="#767676"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding IsHoverActivationDisabled, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="ПАПКА"
                           Foreground="#737373"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Margin="2,16,0,7" />

                <Border Style="{StaticResource SettingRow}" Height="58">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,105,0">
                            <TextBlock Text="Папка для файлов"
                                       Foreground="#D7D7D7"
                                       FontSize="12" />
                            <TextBlock Text="{Binding StorageFolder}"
                                       ToolTip="{Binding StorageFolder}"
                                       Foreground="#767676"
                                       FontSize="10"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Style="{StaticResource ActionButton}"
                                Content="Выбрать"
                                Command="{Binding ChooseStorageFolderCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="ФУНКЦИИ"
                           Foreground="#737373"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Margin="2,16,0,7" />

                <Border Height="Auto"
                        Padding="9,6"
                        Background="{DynamicResource Theme.SurfaceLow}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <ItemsControl x:Name="FeaturesList"
                                  ItemsSource="{Binding Features}"
                                  AllowDrop="True"
                                  DragOver="FeaturesList_DragOver"
                                  Drop="FeaturesList_Drop">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="38">
                                    <Border Width="28"
                                            Height="30"
                                            HorizontalAlignment="Left"
                                            Background="Transparent"
                                            Cursor="SizeAll"
                                            ToolTip="Перетащить"
                                            PreviewMouseLeftButtonDown="FeatureDragHandle_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="FeatureDragHandle_PreviewMouseMove"
                                            PreviewMouseLeftButtonUp="FeatureDragHandle_PreviewMouseLeftButtonUp">
                                        <Grid Width="10" Height="14"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Ellipse Width="2" Height="2" Fill="#777777" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Ellipse Width="2" Height="2" Fill="#777777" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <Ellipse Width="2" Height="2" Fill="#777777" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <Ellipse Width="2" Height="2" Fill="#777777" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Ellipse Width="2" Height="2" Fill="#777777" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                            <Ellipse Width="2" Height="2" Fill="#777777" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="#D7D7D7"
                                               FontSize="12"
                                               Margin="36,0,0,0"
                                               VerticalAlignment="Center" />

                                    <ToggleButton Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding IsVisible, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleFeatureCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Показывать функцию" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="БРАУЗЕР"
                           Foreground="#737373"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Margin="2,16,0,7" />

                <Border Style="{StaticResource SettingRow}" Margin="0,0,0,7">
                    <Grid>
                        <TextBlock Text="Браузер"
                                   Foreground="#D7D7D7"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <ComboBox Style="{StaticResource SettingsComboBox}"
                                  ItemsSource="{Binding AvailableBrowsers}"
                                  SelectedItem="{Binding SelectedBrowser, Mode=TwoWay}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRow}" Margin="0,0,0,7">
                    <Grid>
                        <TextBlock Text="Поисковая система"
                                   Foreground="#D7D7D7"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <ComboBox Style="{StaticResource SettingsComboBox}"
                                  ItemsSource="{Binding AvailableSearchEngines}"
                                  SelectedItem="{Binding SelectedSearchEngine, Mode=TwoWay}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingRow}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Режим инкогнито"
                                       Foreground="#D7D7D7"
                                       FontSize="12" />
                            <TextBlock Text="Открывать запросы в приватном окне"
                                       Foreground="#767676"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding IsPrivateBrowserEnabled, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="ОБНОВЛЕНИЯ"
                           Foreground="#737373"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Margin="2,16,0,7" />

                <Border Style="{StaticResource SettingRow}" Height="58">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,105,0">
                            <TextBlock Text="Обновление Mate"
                                       Foreground="#D7D7D7"
                                       FontSize="12" />
                            <TextBlock Text="{Binding UpdateStatusText}"
                                       ToolTip="{Binding UpdateStatusText}"
                                       Foreground="#767676"
                                       FontSize="10"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Style="{StaticResource ActionButton}"
                                Content="{Binding UpdateActionText}"
                                Command="{Binding UpdateActionCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="22,0">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C28383"
                           FontSize="10"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding VersionText}"
                           Foreground="#5F5F5F"
                           FontSize="9"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
