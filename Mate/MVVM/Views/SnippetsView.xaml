<UserControl x:Class="Mate.MVVM.Views.SnippetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Mate.MVVM.ViewModels"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="CaretBrush" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="42,30,38,23">
        <Grid.RowDefinitions><RowDefinition Height="17" /><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Grid.Row="1" Background="#191919" BorderBrush="#323232" BorderThickness="1" CornerRadius="8">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Data="M 7,2 A 5,5 0 1 0 7,12 A 5,5 0 1 0 7,2 M 11,11 L 16,16" Stroke="#8F8F8F" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" /></Viewbox>
                <TextBox Grid.Column="1" Style="{StaticResource SearchBox}" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0" ToolTip="Поиск по закреплённым" />
            </Grid>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding FilteredItems}" Margin="0,13,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:PinnedItemViewModel}">
                    <Border Height="35" BorderBrush="#252525" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" Foreground="#8E8E8E" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#ECECEC" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="#9A9A9A" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
