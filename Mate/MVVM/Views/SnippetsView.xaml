<UserControl x:Class="Mate.MVVM.Views.SnippetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="42,30,38,30">
        <TextBlock Text="{Binding Title}" Foreground="#A1A1A1" FontSize="17" />
        <TextBox Margin="0,22,0,0" Height="38" Background="#222222" BorderBrush="#3A3A3A" Foreground="#EAEAEA" Padding="12,8" ToolTip="Поиск по заготовкам" />
        <TextBlock Text="Сохранённые тексты будут отображаться здесь." Foreground="#8C8C8C" FontSize="14" Margin="0,21,0,0" />
    </StackPanel>
</UserControl>
