<Application x:Class="Mate.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Mate.MVVM.Views"
             xmlns:vms="clr-namespace:Mate.MVVM.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type vms:MusicViewModel}"><views:MusicView /></DataTemplate>
            <DataTemplate DataType="{x:Type vms:FolderViewModel}"><views:FolderView /></DataTemplate>
            <DataTemplate DataType="{x:Type vms:ClipboardViewModel}"><views:ClipboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vms:SnippetsViewModel}"><views:SnippetsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vms:IncognitoViewModel}"><views:IncognitoView /></DataTemplate>
            <DataTemplate DataType="{x:Type vms:TranslatorViewModel}"><views:TranslatorView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
